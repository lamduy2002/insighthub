# Copy to chatops-bot/.env (gitignored). Never commit real values.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Slack user ID of the bot itself (auth.test), used to ignore its own messages
SLACK_BOT_USER_ID=
# Comma-separated Slack user IDs allowed to request write actions (scale)
CHATOPS_APPROVERS=
# Optional overrides
# CHATOPS_NAMESPACE=insighthub-local
# CHATOPS_AUDIT_LOG=chatops-bot/chatops-audit.log
# PROMETHEUS_URL=http://localhost:9090
